# Copy to .env and fill in. Never commit .env.

# Copilot (optional) — Typhoon API (OpenAI-compatible); falls back to templates when unset
# Get a key at https://playground.opentyphoon.ai/
LLM_API_KEY=
LLM_BASE_URL=https://api.opentyphoon.ai/v1
LLM_MODEL=typhoon-v2.5-30b-a3b-instruct

# Frontend: true = use src/mocks/, false = call the FastAPI backend
VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:8000
